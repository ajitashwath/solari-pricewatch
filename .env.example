# Get a key at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Optional: route the scrape through residential proxy egress in this
# country (e.g. "us", "gb"). Leave unset to scrape directly.
PRICEWATCH_PROXY_COUNTRY=

# Optional: threshold (as a fraction, e.g. 0.05 = 5%) above which a price
# move is flagged as significant in the report.
PRICEWATCH_ALERT_THRESHOLD=0.05
